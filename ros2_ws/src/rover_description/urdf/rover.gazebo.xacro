<?xml version="1.0"?>
<!--
  rover.gazebo.xacro : everything specific to Gazebo Harmonic.
  Uses properties (wheel_radius, track_width) defined in rover.urdf.xacro.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= Wheel friction ================= -->
  <!-- Equal friction in every direction, like a real rubber tire.
       (Unequal mu1/mu2 without fdir1 gets tied to the WORLD axes, which made the
       robot lose the ability to turn after rotating ~90 degrees.)
       Set for the prototype's small hobby rubber tires on smooth, dry tile: ~0.5.
       Measure it: put a wheel on a tile, tilt the tile until the wheel starts to
       slide (block it from rolling), and use tan(angle). Dusty tile is lower. -->
  <xacro:property name="wheel_mu" value="0.5"/>
  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1>${wheel_mu}</mu1>
      <mu2>${wheel_mu}</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_friction link="front_left_wheel_link"/>
  <xacro:wheel_friction link="front_right_wheel_link"/>
  <xacro:wheel_friction link="rear_left_wheel_link"/>
  <xacro:wheel_friction link="rear_right_wheel_link"/>

  <!-- ================= Drive system ================= -->
  <!-- Skid-steer robots slip sideways when turning, so they rotate less than the
       wheel speeds predict. Calibrate: spin in place, compare how far the robot
       turned in Gazebo with how far RViz says it turned, and set this to
       (RViz rotation / Gazebo rotation). 1.0 = no correction. -->
  <xacro:property name="turn_slip_factor" value="1.0"/>

  <!-- DiffDrive accepts multiple joints per side, which makes it a skid-steer controller.
       It listens on /cmd_vel and publishes /odom plus the odom -> base_footprint transform. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <wheel_separation>${track_width * turn_slip_factor}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- Limits must be given as min AND max. With only a max, the min defaults to
           unlimited, so the robot brakes instantly in one direction and slowly in
           the other: that was the slide after D turns. -->
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_angular_acceleration>-6.0</min_angular_acceleration>
      <max_angular_acceleration>6.0</max_angular_acceleration>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- Publishes all four wheel joint positions/velocities (the simulated encoders) -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ================= TF-Luna sensors ================= -->
  <!-- The TF-Luna is a single-point lidar: one distance reading in a 2 degree cone.
       Gazebo has no cone sensor, so this is a tiny lidar with 5 rays spread across
       the 2 degree width. tfluna_scan_to_range.py turns the 5 rays into one
       sensor_msgs/Range reading, the same message a real TF-Luna driver publishes.
       Values below are from the Benewake TF-Luna datasheet. -->
  <xacro:macro name="gz_tfluna" params="link topic">
    <gazebo reference="${link}">
      <sensor name="${link}_sensor" type="gpu_lidar">
        <gz_frame_id>${link}</gz_frame_id>
        <topic>${topic}</topic>
        <update_rate>100</update_rate>          <!-- datasheet default: 100 Hz (1-250 Hz adjustable) -->
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>${-pi/180}</min_angle>   <!-- 2 degree FOV = +/- 1 degree -->
              <max_angle>${pi/180}</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>                       <!-- blind below 20 cm -->
            <max>8.0</max>                       <!-- 8 m on bright targets; ~2.5 m on dark ones -->
            <resolution>0.01</resolution>        <!-- 1 cm -->
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.03</stddev>                <!-- datasheet accuracy is +/-6 cm up to 3 m -->
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:gz_tfluna link="front_tfluna_link" topic="/tfluna_front/scan"/>
  <xacro:gz_tfluna link="rear_tfluna_link"  topic="/tfluna_rear/scan"/>

</robot>
