<?xml version="1.0"?>
<!--
  rover.urdf.xacro : robot structure (links, joints, geometry, inertia).
  Gazebo-specific content (drive plugin, lidar sensors, friction) lives in
  rover.gazebo.xacro, included at the bottom.

  All dimensions below are PLACEHOLDERS. Replace them with your real measurements.
  Units: meters, kilograms, radians.
-->
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= Dimensions ================= -->
  <xacro:property name="chassis_length"   value="0.60"/>
  <xacro:property name="chassis_width"    value="0.40"/>
  <xacro:property name="chassis_height"   value="0.15"/>
  <xacro:property name="chassis_mass"     value="15.0"/>
  <xacro:property name="chassis_z_offset" value="0.05"/>  <!-- chassis center height above the wheel axles -->

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.06"/>
  <xacro:property name="wheel_mass"   value="1.0"/>
  <xacro:property name="wheelbase"    value="0.40"/>  <!-- front axle to rear axle -->
  <xacro:property name="wheel_gap"    value="0.01"/>  <!-- space between chassis side and wheel -->
  <!-- left wheel center to right wheel center -->
  <xacro:property name="track_width"  value="${chassis_width + wheel_width + 2*wheel_gap}"/>

  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.05"/>
  <xacro:property name="lidar_mass"   value="0.2"/>
  <xacro:property name="lidar_inset"  value="0.05"/>  <!-- distance from chassis edge to lidar center -->
  <xacro:property name="lidar_fov"    value="${270*pi/180}"/>  <!-- horizontal field of view of each lidar -->

  <!-- ================= Materials ================= -->
  <material name="orange"><color rgba="1.0 0.5 0.1 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>

  <!-- ================= Inertia helper ================= -->
  <!-- Cylinder whose axis is the link's z axis, rotated by rpy -->
  <xacro:macro name="cylinder_inertia" params="m r h rpy">
    <inertial>
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= Base ================= -->
  <!-- base_footprint: on the ground, directly under the robot center (Nav2 convention) -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link: robot center at wheel-axle height -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_mass*(chassis_width**2+chassis_height**2)/12}" ixy="0" ixz="0"
               iyy="${chassis_mass*(chassis_length**2+chassis_height**2)/12}" iyz="0"
               izz="${chassis_mass*(chassis_length**2+chassis_width**2)/12}"/>
    </inertial>
  </link>

  <!-- ================= Wheels ================= -->
  <!-- x_reflect: 1 = front, -1 = rear.  y_reflect: 1 = left, -1 = right -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" rpy="${pi/2} 0 0"/>
    </link>

    <!-- Continuous joint = motor. Its position/velocity in /joint_states is the simulated encoder. -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect*wheelbase/2} ${y_reflect*track_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- ================= Lidars ================= -->
  <xacro:macro name="lidar" params="prefix x yaw">
    <link name="${prefix}_lidar_link">
      <visual>
        <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}" rpy="0 0 0"/>
    </link>

    <joint name="${prefix}_lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_lidar_link"/>
      <origin xyz="${x} 0 ${chassis_z_offset + chassis_height/2 + lidar_height/2}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <!-- Front lidar faces forward; rear lidar is rotated 180 degrees to face backward -->
  <xacro:lidar prefix="front" x="${chassis_length/2 - lidar_inset}"    yaw="0"/>
  <xacro:lidar prefix="rear"  x="${-(chassis_length/2 - lidar_inset)}" yaw="${pi}"/>

  <!-- ================= Gazebo plugins and sensors ================= -->
  <xacro:include filename="$(find rover_description)/urdf/rover.gazebo.xacro"/>

</robot>
