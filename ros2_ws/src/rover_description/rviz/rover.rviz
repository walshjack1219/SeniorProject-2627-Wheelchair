Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.15
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Front TF-Luna
      Enabled: true
      Topic:
        Value: /tfluna_front/range
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 120; 0
      Alpha: 0.5
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Rear TF-Luna
      Enabled: true
      Topic:
        Value: /tfluna_rear/range
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 170; 255
      Alpha: 0.5
      Buffer Length: 1
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Front TF-Luna hits
      Enabled: true
      Topic:
        Value: /tfluna_front/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 255; 120; 0
      Alpha: 1
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Rear TF-Luna hits
      Enabled: true
      Topic:
        Value: /tfluna_rear/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.02
      Color Transformer: FlatColor
      Color: 0; 170; 255
      Alpha: 1
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 100
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Value: false
  Enabled: true
  Global Options:
    Background Color: 40; 40; 44
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_footprint
      Distance: 1.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01
      Pitch: 0.9
      Yaw: 0.8
      Value: Orbit (rviz_default_plugins)
    Saved: ~
