<?xml version="1.0"?>
<!-- Starter URDF outline for a simple differential-drive robot.
		 Replace the example dimensions and inertial values with measured values. -->
<robot name="test_robot">
	<!-- Chassis -->
	<link name="base_link">
		<inertial>
			<origin xyz="0 0 0.10" rpy="0 0 0"/>
			<mass value="10.0"/>
			<inertia ixx="0.20" ixy="0" ixz="0" iyy="0.30" iyz="0" izz="0.40"/>
		</inertial>
		<visual>
			<origin xyz="0 0 0.10" rpy="0 0 0"/>
			<geometry><box size="0.50 0.40 0.15"/></geometry>
			<material name="chassis"><color rgba="0.35 0.35 0.35 1"/></material>
		</visual>
		<collision>
			<origin xyz="0 0 0.10" rpy="0 0 0"/>
			<geometry><box size="0.50 0.40 0.15"/></geometry>
		</collision>
	</link>

	<!-- Left drive wheel -->
	<link name="left_wheel">
		<inertial>
			<mass value="1.0"/>
			<inertia ixx="0.006" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.006"/>
		</inertial>
		<visual>
			<origin xyz="0 0 0" rpy="1.5708 0 0"/>
			<geometry><cylinder radius="0.10" length="0.05"/></geometry>
			<material name="wheel"><color rgba="0.08 0.08 0.08 1"/></material>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="1.5708 0 0"/>
			<geometry><cylinder radius="0.10" length="0.05"/></geometry>
		</collision>
	</link>
	<joint name="left_wheel_joint" type="continuous">
		<parent link="base_link"/>
		<child link="left_wheel"/>
		<origin xyz="0 0.20 0.10" rpy="0 0 0"/>
		<axis xyz="0 1 0"/>
		<limit effort="20" velocity="10"/>
	</joint>

	<!-- Right drive wheel -->
	<link name="right_wheel">
		<inertial>
			<mass value="1.0"/>
			<inertia ixx="0.006" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.006"/>
		</inertial>
		<visual>
			<origin xyz="0 0 0" rpy="1.5708 0 0"/>
			<geometry><cylinder radius="0.10" length="0.05"/></geometry>
			<material name="wheel"/>
		</visual>
		<collision>
			<origin xyz="0 0 0" rpy="1.5708 0 0"/>
			<geometry><cylinder radius="0.10" length="0.05"/></geometry>
		</collision>
	</link>
	<joint name="right_wheel_joint" type="continuous">
		<parent link="base_link"/>
		<child link="right_wheel"/>
		<origin xyz="0 -0.20 0.10" rpy="0 0 0"/>
		<axis xyz="0 1 0"/>
		<limit effort="20" velocity="10"/>
	</joint>

	<!-- Add support casters, sensors, and Gazebo plugins here as needed. -->



